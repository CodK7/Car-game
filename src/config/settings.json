{
  "_doc": "Player settings (gear button). fpsCap 0 = no limit; scale 0 = use the quality preset's renderScale. maxDpr caps devicePixelRatio before renderScale is applied.",
  "fpsOptions": [0, 30, 45, 60, 90, 120],
  "scale": { "min": 0.3, "max": 2.0, "step": 0.05 },
  "defaults": {
    "desktop": { "quality": "auto", "fpsCap": 0, "scale": 0, "showFps": false, "touch": "auto", "driftAssist": true },
    "mobile": { "quality": "low", "fpsCap": 30, "scale": 0, "showFps": false, "touch": "auto", "driftAssist": true }
  },
  "maxDpr": { "desktop": 1.25, "mobile": 1.5 },
  "touch": { "stickRadius": 64, "steerExponent": 1.35, "lookGain": 1.6 }
}
